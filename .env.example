# ─────────────────────────────────────────────────────────────
# SOCForge — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────
APP_ENV=development
APP_NAME=SOCForge
APP_VERSION=0.1.0
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
DEBUG=false
LOG_LEVEL=INFO

# ── API Server ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://socforge:socforge@postgres:5432/socforge
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Authentication ──────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# bcrypt rounds — higher = slower = more secure
PASSWORD_HASH_ROUNDS=12

# ── AI Provider ────────────────────────────────────────────
# Options: openai, ollama, vllm, none
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4096

# Ollama (local LLM)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ── Storage ─────────────────────────────────────────────────
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# ── Observability ───────────────────────────────────────────
ENABLE_TELEMETRY=false
OTLP_ENDPOINT=http://localhost:4317

# ── Security ────────────────────────────────────────────────
# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Demo Mode ──────────────────────────────────────────────
DEMO_MODE=false

# ── First Admin User (created on first start) ─────────────
FIRST_ADMIN_EMAIL=admin@socforge.local
FIRST_ADMIN_PASSWORD=change-me-immediately
